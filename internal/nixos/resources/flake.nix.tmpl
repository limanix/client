{
  description = "Limanix guest configuration";

  inputs = {
    nixpkgs.url = "{{.NixpkgsURL}}";
    nixos-lima = {
      url = "{{.NixosLimaURL}}";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = inputs@{ self, nixpkgs, ... }:
    let
      runtime = builtins.fromJSON (builtins.readFile ./runtime.json);
      systems = {
        arm64 = "aarch64-linux";
        amd64 = "x86_64-linux";
      };
    in {
      nixosConfigurations.runtime = nixpkgs.lib.nixosSystem {
        specialArgs = {
          runtime = throw ''
            LimaNix no longer provides the `runtime` module argument. Use public
            config.limanix.user options and the corresponding NixOS options instead.
            Migration guide: https://docs.limanix.dev/modules/custom#what-a-module-can-use
          '';
          inputs = throw ''
            LimaNix no longer provides the `inputs` module argument. Root-flake inputs
            are private client data and have no public replacement.
            Migration guide: https://docs.limanix.dev/modules/custom#what-a-module-can-use
          '';
        };
        modules = [
          { nixpkgs.hostPlatform = systems.${runtime.arch}; }
          inputs.nixos-lima.nixosModules.lima
          ./interface.nix
          ./platform.nix
          ./defaults.nix
          ./runtime.nix
          ./lmx.nix
          ./packages.nix
          ./shell.nix
          ./workspace.nix
        ]
          ++ builtins.map (path: ./. + "/${path}") runtime.modules;
      };

      # This generation's lmx, lmxd and configuration, for an lmxd that runs before the system is built.
      packages.${systems.${runtime.arch}}.lmx = self.nixosConfigurations.runtime.config.system.build.lmx;
    };
}
